{
  "name": "pedidos-b2b",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "app",
    "backend",
    "infra"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run && npm test -w app",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "smoke": "vitest run --config tests/smoke/vitest.config.ts",
    "synth": "npm run synth -w infra",
    "bootstrap:dev": "AWS_PROFILE=default npm run bootstrap -w infra -- --context stage=dev --context region=us-east-1",
    "deploy:dev": "AWS_PROFILE=default npm run deploy -w infra -- --context stage=dev --context region=us-east-1 && tsx scripts/write-env.ts dev && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "order:set-status": "tsx scripts/order-set-status.ts",
    "app": "npm run start -w app",
    "check:spec": "node scripts/check-spec.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@eslint/js": "^10.0.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "graphql": "^16.14.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.2.3"
  }
}
